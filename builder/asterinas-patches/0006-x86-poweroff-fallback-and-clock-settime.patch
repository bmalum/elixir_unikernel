+///
+/// The last-resort reboot method, used when neither the ACPI reset register
+/// nor the i8042 controller exist (e.g. on EC2 Nitro). Loads an empty IDT and
+/// raises a software interrupt; the CPU cannot deliver it, cannot deliver the
+/// resulting double fault either, and resets. Does not return.
+pub fn triple_fault() -> ! {
+    // SAFETY: We are intentionally bringing the machine down. Nothing runs after
+    // this on the current CPU; other CPUs stop when the chipset resets.
+    unsafe {
+        let null_idt: [u8; 10] = [0; 10];
+        core::arch::asm!(
+            "cli",
+            "lidt [{}]",
+            "int3",
+            in(reg) null_idt.as_ptr(),
+            options(nostack, noreturn)
+        );
+    }
+}
