+    /// `SET_FEATURE` with `inline_data` plus `ctrl` bytes in the control buffer.
+    pub(crate) fn set_feature_indirect(&mut self, feature_id: u8, inline_data: &[u32], ctrl: &[u8]) -> Result<(), AdminError> {
